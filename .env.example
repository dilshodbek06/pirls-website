# ==================================
# NETLIFY DEPLOYMENT - ENV VARIABLES
# ==================================
# Bu faylni .env ga nusxalab, qiymatlarni to'ldiring
# Netlify Dashboard > Site Settings > Environment Variables ga ham qo'shing

# PostgreSQL database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# iron-session uchun maxfiy kalit (KAMIDA 32 belgi bo'lishi SHART!)
# Generator: https://generate-secret.vercel.app/32
SECRET_COOKIE_PASSWORD=your-super-secret-cookie-password-min-32-chars

# Google Gemini API key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Ixtiyoriy: Vercel Blob token (bo'lmasa rasmlар base64 formatda saqlanadi)
# BLOB_READ_WRITE_TOKEN=
